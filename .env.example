# Gmail SMTP credentials used by /api/careers to send applications.
# Create a Google Account "App Password" (requires 2-Step Verification):
#   https://myaccount.google.com/apppasswords
# Use the full 16-character password (spaces are fine; nodemailer strips them).

GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where career applications are delivered. Defaults to hr.amectechnology@gmail.com if unset.
CAREERS_RECIPIENT=hr.amectechnology@gmail.com

# Google Apps Script Web App URL for career application sync (optional).
# When set, /api/careers also POSTs each submission as JSON (with the resume
# Base64-encoded) to this URL. The Apps Script saves the PDF to a Drive folder
# and appends a row to a Google Sheet.
#
# Setup (see Job_Application_Sync_Spec.pdf for full walkthrough):
#   1. Create a Drive folder for resumes, note its ID
#   2. Create a Google Sheet, open Extensions → Apps Script
#   3. Add handler script, deploy as Web app (Execute as: Me, Access: Anyone)
#   4. Copy the deployment URL (ends in /exec) here
CAREERS_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
