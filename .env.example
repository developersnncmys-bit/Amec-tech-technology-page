# Gmail SMTP credentials used by /api/careers to send applications.
# Create a Google Account "App Password" (requires 2-Step Verification):
#   https://myaccount.google.com/apppasswords
# Use the full 16-character password (spaces are fine; nodemailer strips them).

GMAIL_USER=your.sender@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where career applications are delivered. Defaults to hr.amectechnology@gmail.com if unset.
CAREERS_RECIPIENT=hr.amectechnology@gmail.com
