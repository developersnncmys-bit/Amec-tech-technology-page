function WhyThisMatters() {
  const sectionRef = useRef<HTMLElement | null>(null);

  useIsomorphicLayoutEffect(() => {
    const el = sectionRef.current;
    if (!el) return;

    const ctx = gsap.context(() => {
      gsap.from("[data-wtm-card]", {
        autoAlpha: 0,
        x: -40,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 75%" },
      });
      gsap.from("[data-wtm-image]", {
        autoAlpha: 0,
        x: 40,
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 75%" },
      });
      gsap.from("[data-wtm-point]", {
        autoAlpha: 0,
        x: -20,
        duration: 0.5,
        stagger: 0.12,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 70%" },
      });
    }, el);

    return () => ctx.revert();
  }, []);

  return (
    <section ref={sectionRef} className="relative w-full overflow-hidden py-20 md:py-28">
      <Shell>
        <div className="relative grid gap-6 overflow-hidden rounded-2xl border border-white/[0.08] md:grid-cols-2">
          {/* Left card */}
          <div data-wtm-card className="relative z-10 bg-bg-card p-8 md:p-12">
            <h2 className="heading-lg">WHY THIS MATTERS</h2>

            <ul className="mt-8 space-y-5 md:mt-10">
              {WHY_MATTERS_POINTS.map((p) => (
                <li key={p} data-wtm-point className="flex items-start gap-3 text-white/85">
                  <span
                    aria-hidden
                    className="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-white"
                  />
                  <span className="text-sm leading-relaxed md:text-base">{p}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Right image */}
