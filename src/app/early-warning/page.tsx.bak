  );
}

// ---------------------------------------------------------------------------
// Comparison Table — AMEC vs Traditional
// ---------------------------------------------------------------------------

function Check() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-4 w-4 text-emerald-400"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden
    >
      <path d="m5 12 5 5L20 7" />
    </svg>
  );
}

function Cross() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-4 w-4 text-red-400/80"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden
    >
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  );
}

function ComparisonTable() {
  const sectionRef = useRef<HTMLElement | null>(null);

  useIsomorphicLayoutEffect(() => {
    const el = sectionRef.current;
    if (!el) return;

    const ctx = gsap.context(() => {
      // Heading — slide-up + clip reveal
      gsap.from("[data-ct-heading]", {
        autoAlpha: 0,
        y: 30,
        clipPath: "inset(100% 0 0 0)",
        duration: 0.9,
        ease: "power3.out",
        scrollTrigger: { trigger: el, start: "top 80%" },
      });

      // Table outer border draws in from left
      gsap.from("[data-ct-border]", {
        scaleX: 0,
        transformOrigin: "left center",
        duration: 1,
        ease: "power3.inOut",
        scrollTrigger: { trigger: "[data-ct-table]", start: "top 85%" },
      });

      // Center-column spotlight — fade + scale down into position
      gsap.from("[data-ct-spotlight]", {
        autoAlpha: 0,
        scaleY: 0.95,
        transformOrigin: "top center",
        duration: 1,
        ease: "power3.out",
        scrollTrigger: { trigger: "[data-ct-table]", start: "top 80%" },
      });

      // RECOMMENDED badge — pops in with back ease
      gsap.from("[data-ct-badge]", {
        autoAlpha: 0,
        scale: 0.5,
        y: -8,
        duration: 0.7,
        delay: 0.3,
        ease: "back.out(2)",
        scrollTrigger: { trigger: "[data-ct-table]", start: "top 80%" },
      });

      // Header cells — stagger fade down
      gsap.from("[data-ct-header]", {
        autoAlpha: 0,
        y: -12,
        duration: 0.6,
        stagger: 0.12,
        delay: 0.2,
        ease: "power3.out",
        scrollTrigger: { trigger: "[data-ct-table]", start: "top 80%" },
      });

      // Row cells — each row's cells cascade in from below
      const rows = gsap.utils.toArray<HTMLElement>("[data-ct-row]");
      rows.forEach((row, i) => {
        const cells = row.querySelectorAll<HTMLElement>("[data-ct-cell]");
        gsap.from(cells, {
          autoAlpha: 0,
          y: 20,
          duration: 0.5,
          stagger: 0.06,
          delay: 0.45 + i * 0.08,
          ease: "power3.out",
          scrollTrigger: { trigger: "[data-ct-table]", start: "top 80%" },
        });
      });

      // Check / Cross marks — pop with back ease after rows settle
      const marks = gsap.utils.toArray<HTMLElement>("[data-ct-mark]");
      marks.forEach((mark, i) => {
        gsap.from(mark, {
          autoAlpha: 0,
          scale: 0.3,
          rotate: -45,
          duration: 0.5,
          delay: 0.75 + i * 0.04,
          ease: "back.out(2.5)",
          scrollTrigger: { trigger: "[data-ct-table]", start: "top 80%" },
        });
      });
    }, el);

    const refreshId = window.setTimeout(() => ScrollTrigger.refresh(), 200);
    return () => {
      window.clearTimeout(refreshId);
      ctx.revert();
    };
  }, []);

  const renderCell = (val: string | boolean) => {
    if (typeof val === "boolean") {
      return (
        <span data-ct-mark className="inline-flex">
          {val ? <Check /> : <Cross />}
        </span>
      );
    }
    return <span className="text-[13px] text-white md:text-sm">{val}</span>;
  };

  return (
    <section ref={sectionRef} className="w-full py-14 md:py-20">
      <Shell>
        <h2 data-ct-heading className="heading-lg text-center">
          AMEC VS. TRADITIONAL SECURITY
        </h2>

        {/* Compact table — max-w so it doesn't balloon on wide screens */}
        <div className="relative mx-auto mt-10 w-full max-w-4xl pt-5 md:mt-12 md:pt-6">
          {/* Center-column spotlight overlaying the AMEC column + floating badge */}
          <div
            aria-hidden
            className="pointer-events-none absolute inset-x-0 bottom-0 top-0 grid grid-cols-[1.3fr_1fr_1fr]"
          >
            <div />
            <div
              data-ct-spotlight
              className="relative rounded-2xl border border-white/25 bg-white/[0.02]"
            >
              <span
                data-ct-badge
                className="pointer-events-auto absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full border border-white/15 bg-black px-3 py-1 font-display text-[10px] font-semibold uppercase tracking-[0.2em] text-white md:px-4 md:py-1.5 md:text-[11px]"
              >
                Recommended
              </span>
            </div>
            <div />
          </div>

          {/* Table grid */}
          <div data-ct-table className="relative overflow-hidden rounded-2xl">
            {/* Full-width outer border */}
            <div
              data-ct-border
              aria-hidden
              className="pointer-events-none absolute inset-0 rounded-2xl border border-white/[0.08]"
            />

            {/* Header row — tighter padding */}
            <div className="relative grid grid-cols-[1.3fr_1fr_1fr]">
              <div
                data-ct-header
                className="px-4 py-3.5 text-[11px] font-semibold uppercase tracking-[0.18em] text-white/60 md:px-6 md:py-4 md:text-xs"
              >
                Feature
              </div>
              <div
                data-ct-header
                className="px-4 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-white md:px-6 md:py-4 md:text-xs"
              >
                AMEC Security
              </div>
              <div
                data-ct-header
                className="px-4 py-3.5 text-center text-[11px] font-semibold uppercase tracking-[0.18em] text-white/60 md:px-6 md:py-4 md:text-xs"
              >
                Traditional Systems
              </div>
            </div>

            {/* Body rows — reduced vertical padding for Figma density */}
            {COMPARISON_ROWS.map((row) => (
              <div
                key={row.feature}
                data-ct-row
                className="relative grid grid-cols-[1.3fr_1fr_1fr] border-t border-white/[0.06]"
              >
                <div
                  data-ct-cell
                  className="px-4 py-3 text-[13px] text-white/80 md:px-6 md:py-3.5 md:text-sm"
                >
                  {row.feature}
                </div>
                <div
                  data-ct-cell
                  className="flex items-center justify-center px-4 py-3 md:px-6 md:py-3.5"
                >
                  {renderCell(row.amec)}
                </div>
                <div
                  data-ct-cell
                  className="flex items-center justify-center px-4 py-3 md:px-6 md:py-3.5"
                >
                  {renderCell(row.traditional)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </Shell>
    </section>
  );
}

